# Przykładowa konfiguracja .env dla środowiska produkcyjnego
# Skopiuj ten plik jako .env i uzupełnij odpowiednie wartości

# ==========================================
# Aplikacja
# ==========================================
APP_NAME="Multilingual Journal"
APP_ENV=production
APP_KEY=base64:GENERATE_THIS_WITH_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ==========================================
# Logging
# ==========================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==========================================
# Baza danych MySQL (Docker)
# ==========================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=journal_db
DB_USERNAME=journal_user
DB_PASSWORD=STRONG_RANDOM_PASSWORD_HERE

# Root password dla MySQL (używane w docker-compose)
DB_ROOT_PASSWORD=ANOTHER_STRONG_PASSWORD

# ==========================================
# Session i Cache (Redis)
# ==========================================
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=journal_cache

# ==========================================
# Redis (Docker)
# ==========================================
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# Kolejki (Database)
# ==========================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ==========================================
# Mail (konfiguruj zgodnie z dostawcą)
# ==========================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# AWS S3 (opcjonalnie dla storage)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# Vite
# ==========================================
VITE_APP_NAME="${APP_NAME}"

# ==========================================
# Security & Performance
# ==========================================
# Włącz HTTPS w produkcji
# FORCE_HTTPS=true

# Trusted proxies (dla load balancer / reverse proxy)
# TRUSTED_PROXIES=*

# CORS (jeśli używasz API)
# SANCTUM_STATEFUL_DOMAINS=your-domain.com
# SESSION_DOMAIN=.your-domain.com
