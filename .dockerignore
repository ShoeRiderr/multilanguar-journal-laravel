# Ignoruj pliki i katalogi niepotrzebne w Docker image

# Dependencies
node_modules/
vendor/
npm-debug.log
yarn-error.log
package-lock.json

# Environment files (nigdy nie kopiuj do image!)
.env
.env.*
!.env.example

# Git
.git/
.gitignore
.gitattributes

# IDE
.idea/
.vscode/
.fleet/
.nova/
.zed/
*.swp
*.swo
*~

# Storage (wygenerowane pliki)
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/debugbar/*
storage/app/public/*

# Public build files (będą zbudowane w image)
public/hot
public/build
public/storage

# Tests i cache
.phpunit.cache
.phpunit.result.cache
coverage/
tests/

# Documentation
*.md
!README.md
docs/

# CI/CD
.github/
.gitlab-ci.yml

# Docker
docker-compose.yml
docker-compose*.yml
Dockerfile
.dockerignore

# Misc
*.log
.DS_Store
Thumbs.db
auth.json
.phpactor.json
